# Copy this file to .env and fill in your values.
# Never commit the .env file.

# PostgreSQL
POSTGRES_DB=train_booking
POSTGRES_USER=trainuser
POSTGRES_PASSWORD=changeme_use_a_strong_password

# Backend
PORT=4000
# Fare in LKR per km (reserved coach)
RATE_PER_KM=2.5

# Frontend (the URL the BROWSER uses to reach the backend)
# When running via docker-compose, keep this as-is.
VITE_API_URL=http://localhost:4000
